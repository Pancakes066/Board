// Board — data model
// See /root/.claude/plans/polished-percolating-globe.md for the full design
// rationale (unified Transaction model, sourceDate/date split, etc).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum Plan {
  FREE
  PREMIUM
}

enum FlowType {
  INCOME
  EXPENSE
  SAVINGS
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum OccurrenceStatus {
  PLANNED // "prévue"
  COMPLETED // "effectuée"
  SKIPPED // user explicitly cancelled this one occurrence
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ARCHIVED
}

enum ProjectType {
  TRAVEL
  PURCHASE
  EVENT
  MOVING
  OTHER
}

enum ProjectExpenseStatus {
  PLANNED
  COMPLETED
}

enum FinancialAccountType {
  CHECKING
  SAVINGS_BOOK
  CARD
  CASH
  OTHER
}

enum ReminderFrequency {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum ReminderStatus {
  ACTIVE
  INACTIVE
  COMPLETED
}

// ============================================================
// AUTH — standard Auth.js / Prisma adapter shape.
// `Account` here = OAuth-provider link, NOT a financial account.
// ============================================================

model User {
  id                   String    @id @default(cuid())
  name                 String?
  email                String    @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String? // null for OAuth-only users
  plan                 Plan      @default(FREE)
  currency             String    @default("EUR")
  startingBalanceCents Int       @default(0)
  startingBalanceDate  DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  categories        Category[]
  recurringRules    RecurringRule[]
  transactions      Transaction[]
  budgets           Budget[]
  savingsGoals      SavingsGoal[]
  projects          Project[]
  projectExpenses   ProjectExpense[]
  financialAccounts FinancialAccount[]
  accountTransfers  AccountTransfer[]
  reminders         Reminder[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// CATEGORIES — default (userId=null) + user-scoped custom
// ============================================================

model Category {
  id        String   @id @default(cuid())
  userId    String? // null = global default category
  name      String
  emoji     String?
  color     String? // stable hex color, for chart consistency
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringRules RecurringRule[]
  transactions   Transaction[]
  budgets        Budget[]
  reminders      Reminder[]

  @@unique([userId, name])
}

// ============================================================
// RECURRING RULES — income / expense / savings, incl. subscriptions
// ============================================================

model RecurringRule {
  id             String              @id @default(cuid())
  userId         String
  type           FlowType
  name           String
  amountCents    Int
  frequency      RecurrenceFrequency
  dayOfMonth     Int? // 1-31 — MONTHLY & YEARLY (clamped to last day of month)
  month          Int? // 1-12 — YEARLY only
  dayOfWeek      Int? // 0(Sun)-6(Sat) — WEEKLY only
  startDate      DateTime
  endDate        DateTime?
  categoryId     String
  isSubscription Boolean             @default(false) // meaningful when type=EXPENSE
  savingsGoalId  String? // meaningful when type=SAVINGS
  accountId      String? // optional — which financial account this rule applies to
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category          @relation(fields: [categoryId], references: [id])
  savingsGoal SavingsGoal?      @relation(fields: [savingsGoalId], references: [id])
  account     FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  occurrences Transaction[]
  reminders   Reminder[]

  @@index([userId, type])
  @@index([userId, isSubscription])
  @@index([accountId])
}

// ============================================================
// TRANSACTIONS — generated occurrences + manual entries, unified
// ============================================================

model Transaction {
  id               String           @id @default(cuid())
  userId           String // denormalized — avoids joining through RecurringRule on hot queries
  recurringRuleId  String? // null = manual, one-off entry
  type             FlowType
  status           OccurrenceStatus @default(PLANNED)
  amountCents      Int // effective amount — may override the parent rule's amount
  categoryId       String
  savingsGoalId    String?
  projectExpenseId String?          @unique // set when this is a reserved/paid project budget line
  accountId        String? // optional — which financial account this transaction moved money in/out of
  sourceDate       DateTime // IMMUTABLE — rule-computed date, idempotency anchor
  date             DateTime // mutable, user-facing/effective date (the override target)
  periodYear       Int // aggregation bucket — derived from sourceDate, not date
  periodMonth      Int // 1-12
  isModified       Boolean          @default(false) // true once amount/date/category diverge from the rule
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringRule  RecurringRule?    @relation(fields: [recurringRuleId], references: [id], onDelete: Cascade)
  category       Category          @relation(fields: [categoryId], references: [id])
  savingsGoal    SavingsGoal?      @relation(fields: [savingsGoalId], references: [id])
  projectExpense ProjectExpense?   @relation(fields: [projectExpenseId], references: [id], onDelete: Cascade)
  account        FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  // NULLs are distinct in Postgres unique indexes, so manual transactions
  // (recurringRuleId = null) never collide with each other here — this
  // constraint only ever matters for generated rows.
  @@unique([recurringRuleId, sourceDate])
  @@index([userId, periodYear, periodMonth])
  @@index([userId, type, status])
  @@index([userId, categoryId])
  @@index([accountId])
}

// ============================================================
// BUDGETS — ongoing per-category cap (no month-by-month rows)
// ============================================================

model Budget {
  id          String   @id @default(cuid())
  userId      String
  categoryId  String
  amountCents Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category   @relation(fields: [categoryId], references: [id])
  reminders Reminder[]

  @@unique([userId, categoryId])
}

// ============================================================
// SAVINGS GOALS
// ============================================================

model SavingsGoal {
  id                 String     @id @default(cuid())
  userId             String
  name               String
  emoji              String?
  targetAmountCents  Int
  initialAmountCents Int        @default(0) // "already saved" at goal-creation time
  targetDate         DateTime?
  status             GoalStatus @default(ACTIVE)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  accountId String? // optional — which financial account this goal's money actually sits in

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringRules RecurringRule[]
  transactions   Transaction[]
  project        Project?
  account        FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  reminders      Reminder[]
  // currentAmountCents is intentionally NOT a column — computed from
  // initialAmountCents + completed linked transactions. See
  // src/server/services/savings/goal-projection.ts.

  @@index([accountId])
}

// ============================================================
// PROJECTS — one-off financial plans (trips, purchases, events...).
// Reuses SavingsGoal for the "how much saved / suggested monthly
// contribution" math (via savingsGoalId) and Transaction for real money
// movement (via ProjectExpense.transaction) — no parallel bookkeeping.
// ============================================================

model Project {
  id                    String      @id @default(cuid())
  userId                String
  type                  ProjectType
  name                  String
  emoji                 String? // defaults by type in the UI when unset
  description           String?
  estimatedAmountCents  Int
  currency              String      @default("EUR") // display currency for the target budget
  targetDate            DateTime? // "date prévue"
  deadlineDate          DateTime? // "date limite" — distinct, optional hard cutoff
  budgetSafetyMarginPct Int? // recommended-budget cushion, e.g. 10 = +10%
  fxSafetyMarginPct     Int? // exchange-rate cushion for foreign-currency lines
  savingsGoalId         String?     @unique
  // Travel-mode fields — null unless type = TRAVEL
  destination           String?
  travelStartDate       DateTime?
  travelEndDate         DateTime?
  travelerCount         Int?
  notes                 String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  savingsGoal SavingsGoal?     @relation(fields: [savingsGoalId], references: [id])
  expenses    ProjectExpense[]
  reminders   Reminder[]

  @@index([userId])
}

model ProjectExpense {
  id                   String               @id @default(cuid())
  projectId            String
  userId               String // denormalized, same convention as Transaction
  label                String // "Transport", "Hébergement"... free text, like Category
  emoji                String?
  amountCents          Int // amount in the line's own (possibly foreign) currency
  currency             String               @default("EUR")
  convertedAmountCents Int? // home-currency (EUR) snapshot taken at entry time
  exchangeRate         Float? // rate used for that snapshot
  convertedAt          DateTime?
  plannedDate          DateTime?
  status               ProjectExpenseStatus @default(PLANNED)
  note                 String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction?

  @@index([projectId])
}

// ============================================================
// EXCHANGE RATES — a small cache/fallback in front of a live FX API.
// Global (not per-user): rates aren't user-specific. Every read carries
// its own fetchedAt, so the UI never claims a cached rate is live.
// ============================================================

// Append-only: one row per (pair, published date), not overwritten in
// place — so this also serves as a rate history (7d/30d/1y evolution
// charts can query it directly later) without a separate table.
model ExchangeRate {
  id            String   @id @default(cuid())
  baseCurrency  String
  quoteCurrency String
  rate          Float
  date          DateTime // the date this rate is FOR, per the source — not our fetch time
  fetchedAt     DateTime @default(now()) // when WE retrieved it, for cache-freshness bookkeeping

  @@unique([baseCurrency, quoteCurrency, date])
  @@index([baseCurrency, quoteCurrency, date])
}

// ============================================================
// FINANCIAL ACCOUNTS — multi-account support. Deliberately named
// "FinancialAccount" (not "Account") since that name is already taken by
// Auth.js's OAuth-link table above. A financial account is a label, never
// an owner: every FK pointing at it is optional with onDelete: SetNull,
// so deleting an account never deletes transactions/rules/goals — it just
// un-links them.
// ============================================================

model FinancialAccount {
  id                   String               @id @default(cuid())
  userId               String
  name                 String
  type                 FinancialAccountType
  currency             String               @default("EUR")
  startingBalanceCents Int                  @default(0)
  startingBalanceDate  DateTime?
  description          String?
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  recurringRules RecurringRule[]
  savingsGoals   SavingsGoal[]
  transfersOut   AccountTransfer[] @relation("TransferFrom")
  transfersIn    AccountTransfer[] @relation("TransferTo")

  @@index([userId])
}

// A transfer is deliberately kept OUT of Transaction (no new FlowType) so
// it can never be counted as income/expense by any existing statistics or
// forecast query — it is purely a movement of the user's own money
// between two of their own accounts.
model AccountTransfer {
  id            String   @id @default(cuid())
  userId        String
  fromAccountId String
  toAccountId   String
  amountCents   Int
  date          DateTime
  note          String?
  createdAt     DateTime @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount FinancialAccount @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccount   FinancialAccount @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([fromAccountId])
  @@index([toAccountId])
}

// ============================================================
// REMINDERS — standalone from Transaction on purpose: a reminder never
// automatically creates a transaction. Optional links to existing
// financial objects are for context/navigation only. Occurrences are
// computed on the fly (see src/server/services/reminders/occurrence-dates.ts),
// mirroring RecurringRule's own occurrence algorithm — no materialized
// occurrence table, so there is nothing to keep in sync.
// ============================================================

model Reminder {
  id              String            @id @default(cuid())
  userId          String
  title           String
  description     String?
  date            DateTime // date of the first/only occurrence
  hour            Int // 0-23
  minute          Int // 0-59
  frequency       ReminderFrequency @default(ONCE)
  dayOfMonth      Int? // MONTHLY / YEARLY (clamped to the last day of short months)
  month           Int? // 1-12 — YEARLY only
  dayOfWeek       Int? // 0(Sun)-6(Sat) — WEEKLY only
  intervalDays    Int? // CUSTOM — "every N days"
  endDate         DateTime?
  status          ReminderStatus    @default(ACTIVE)
  categoryId      String?
  recurringRuleId String?
  budgetId        String?
  savingsGoalId   String?
  projectId       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurringRule RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  budget        Budget?        @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  savingsGoal   SavingsGoal?   @relation(fields: [savingsGoalId], references: [id], onDelete: SetNull)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, date])
}
